# ==========================================
# CYBERSECURITY CLUB — FULL-STACK SYSTEM CONFIG
# ==========================================

# ── DATABASE (PostgreSQL) ───────────────────
POSTGRES_DB=cybersec_club
POSTGRES_USER=cybersec_admin
POSTGRES_PASSWORD=changeme_in_production
DB_PORT=5432

# ── BACKEND (FastAPI) ───────────────────────
# In Docker, use the service name 'db' as the host:
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${DB_PORT}/${POSTGRES_DB}
# For local dev without Docker, use 'localhost':
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${DB_PORT}/${POSTGRES_DB}

# CRITICAL: Generate a secure random key for production (min 32 chars)
# python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=GENERATE_A_REAL_SECRET_KEY_WITH_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=3600

# CORS — Update to your actual domain in production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Admin Seeding (first-run only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_in_production

# Server Settings
BACKEND_PORT=8000
DEBUG=false
RATE_LIMIT_ENABLED=true
MAX_FILE_SIZE_MB=10

# ── FRONTEND (Vite/React) ───────────────────
FRONTEND_PORT=5173
# In production/deployment, Vite is often served via Nginx on port 80/443
VITE_API_URL=/api

# ── MONITORING ──────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=Grafana@2026!
