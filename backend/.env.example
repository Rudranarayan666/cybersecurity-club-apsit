# ==========================================
# ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and update with your actual values.
# For Docker deployment: docker-compose will read from .env automatically.

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# Local development:
DATABASE_URL=postgresql://cybersec_admin:changeme_in_production@localhost:5432/cybersec_club
# Docker (set automatically by docker-compose):
# DATABASE_URL=postgresql://cybersec_admin:changeme_in_production@db:5432/cybersec_club

DB_USER=cybersec_admin
DB_PASSWORD=changeme_in_production
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ==========================================
# SECURITY CONFIGURATION
# ==========================================
# CRITICAL: Generate a secure random key for production (minimum 32 characters)
# Run: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=GENERATE_A_REAL_SECRET_KEY_WITH_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=3600

# Argon2 Password Hashing Parameters
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ==========================================
# CORS CONFIGURATION
# ==========================================
# Update to your actual frontend domain in production
FRONTEND_URL=http://localhost:5500
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ==========================================
# SERVER CONFIGURATION
# ==========================================
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ==========================================
# FILE UPLOAD CONFIGURATION
# ==========================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_ENABLED=true

# ==========================================
# ADMIN CREDENTIALS (for seed_db.py)
# ==========================================
# Change BOTH of these before running in production!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_in_production
